<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" is not honoured for device-to-device transfer on every
     manufacturer. vaayil.db holds Keystore-wrapped secrets that cannot be decrypted on another
     device, so nothing is extractable. Users migrate with a passphrase-encrypted snapshot. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
