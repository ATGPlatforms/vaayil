<?xml version="1.0" encoding="utf-8"?>
<!-- The bare canvas inside one closed seam perimeter, at the system radius on API 31+.
     No shadow: the launcher's own surface sits under the widget (DESIGN.md §5). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vellum_canvas" />
    <stroke
        android:width="1dp"
        android:color="@color/vellum_seam" />
    <corners android:radius="@dimen/quick_widget_radius" />
</shape>
