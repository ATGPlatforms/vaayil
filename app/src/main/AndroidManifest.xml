<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Package visibility (Android 11+): without a queries declaration getInstalledPackages()
         sees almost nothing beyond this app, leaving the split-tunnel picker empty. The
         launcher-intent query makes every app with a launcher entry visible to
         InstalledAppsSource; system components without one stay hidden. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- allowBackup="false" already disables every pre-Android-12 backup path, so the
         fullBackupContent fallback lint asks for alongside dataExtractionRules would never
         be consulted. -->
    <application
        android:name="dev.vaayil.app.VaayilApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:taskAffinity=""
        android:label="Vaayil"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Vaayil">
        <activity
            android:name="dev.vaayil.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with: a .conf file another app hands over, content URIs only. Never BROWSABLE, so a
                 web page can't start an import. -->
            <intent-filter android:label="Import into Vaayil">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share: unknown-type files only, so sharing text or a link never lists Vaayil. No scheme:
                 a share carries its file in EXTRA_STREAM, not in the intent's data. -->
            <intent-filter android:label="Import into Vaayil">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- The launcher shortcut's trampoline: invisible, finishes at once and leaves no task
             behind, no intent filter. -->
        <activity
            android:name="dev.vaayil.app.quick.QuickShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- The Quick Settings tile: only the system's tile binder may bind it. -->
        <service
            android:name="dev.vaayil.app.quick.QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_tile"
            android:label="Vaayil"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The home-screen widget's provider. It stays private: only the system sends it widget
             updates. -->
        <receiver
            android:name="dev.vaayil.app.quick.QuickWidgetProvider"
            android:exported="false"
            android:label="Vaayil">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>
        <!-- The widget disc's connect/disconnect: an explicit broadcast from this app's own
             PendingIntents, so nothing else may send it. -->
        <receiver
            android:name="dev.vaayil.app.quick.QuickWidgetReceiver"
            android:exported="false" />
        <!-- Keep the GoBackend service component (GoBackend starts it explicitly while setting
             the tunnel state up) but replace the AAR declaration wholesale: no intent-filter, so
             the system only ever binds VpnTunnelService for always-on. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:node="replace" />
    </application>
</manifest>
